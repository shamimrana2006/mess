# Environment Variables for Mess Calculation App

# 1. For Local Development (SQLite - Zero Config)
DATABASE_URL="file:./dev.db"

# 2. For Free Vercel Deployment with Neon PostgreSQL (Recommended)
# Sign up at https://neon.tech (Free), create a database and paste the connection string:
# DATABASE_URL="postgresql://user:password@ep-cool-mess-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Note: When deploying to Vercel with PostgreSQL, update datasource db provider in prisma/schema.prisma to "postgresql".

# JWT Secret for Authentication
JWT_SECRET="mess_calculation_super_secret_jwt_key_2026_vercell_free"
